		"@vueuse/core": "^14.2.1",
		"awesome-social-button": "^0.3.5",
		"axios": "^1.14.0",
		"chart.js": "^4.5.1",
		"connect-history-api-fallback": "^2.0.0",
		"cors": "^2.8.6",
		"dms-conversion": "^3.1.4",
		"express": "^5.2.1",
		"formatcoords": "^1.1.3",
		"graphql": "^16.13.2",
		"graphql-tag": "^2.12.6",
		"npm": "^11.12.1",
		"ol": "^10.8.0",
		"ol-contextmenu": "^6.0.0",
		"ol-ext": "^4.0.38",
		"pinia": "^3.0.4",
