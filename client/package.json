		"vite-plugin-vuetify": "^2.1.3",
		"vue": "^3.5.31",
		"vue-flag-icon": "^2.1.0",
		"vue-i18n": "^11.3.0",
		"vue-router": "^5.0.4",
		"vue3-openlayers": "^12.2.2",
		"vuetify": "^3.12.4"
